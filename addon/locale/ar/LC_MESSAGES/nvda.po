#: addon\globalPlugins\instantTimer\settingsGUI.py:19
#: addon\globalPlugins\instantTimer\__init__.py:58 buildVars.py:10
msgid "Instant Timer"
msgstr "المؤقت الفوري"

#: buildVars.py:12
msgid ""
"Countdown timers and stopwatch for NVDA with 5 preset timers, an ad-hoc "
"quick timer, a modal command layer, and audio and speech alerts."
msgstr ""
"إضافة لمؤقتات العد التنازلي وساعة الإيقاف في NVDA، تشتمل على 5 مؤقتات "
"مستقلة وطبقة أوامر سريعة وتنبيهات صوتية ونطقية."

#: buildVars.py:16
msgid ""
"- Version 2026.1: Initial release with 5 preset countdown timers, quick "
"timer, stopwatch, one-shot command layer, and settings panel."
msgstr ""
"- الإصدار 2026.1: الإصدار المبدئي؛ يضم 5 مؤقتات تنازلية، وطبقة أوامر "
"أحادية النفاذ، وساعة إيقاف، ولوحة إعدادات متكاملة في NVDA."

